{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run DRiShti-AI Studio",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Running on (https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
